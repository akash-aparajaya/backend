// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// =============================================================================
// Prisma Schema
// Database: PostgreSQL
// Project: Multi-service, Multi-provider, Multi-environment Management Platform
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  ADMIN
  SUPER_ADMIN
  USER
}

enum RequestStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ApiKeyMode {
  SANDBOX
  LIVE
}

// =============================================================================
// SERVICE TYPES
// =============================================================================

model ServiceType {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  name        String  @unique
  slug        String  @unique
  description String?
  is_active   Boolean @default(true)

  providers Provider[]

  environment_service_providers EnvironmentServiceProvider[]

  @@map("service_types")
}

// =============================================================================
// PROVIDERS
// =============================================================================

model Provider {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  service_type_id String

  service_type ServiceType @relation(fields: [service_type_id], references: [public_id])

  name String

  slug String @unique

  required_credential_schema Json

  base_endpoint String

  is_active Boolean @default(true)

  environment_service_providers EnvironmentServiceProvider[]

  @@map("providers")
}

// =============================================================================
// ENVIRONMENT LIST
// =============================================================================

model EnvironmentList {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  name String @unique

  is_active Boolean @default(true)

  created_at DateTime @default(now())

  @@map("environment_lists")
}

// =============================================================================
// USERS
// =============================================================================

model User {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  email String @unique

  password String

  user_name String

  role UserRole @default(ADMIN)

  phone_number String?

  is_phone_verified Boolean @default(false)

  is_deleted Boolean @default(false)

  is_active Boolean @default(true)

  reset_token String?

  reset_token_expiry DateTime?

  refresh_token_hash String?

  refresh_token_expires_at DateTime?

  last_login_at DateTime?

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  deleted_at DateTime?

  projects Project[]

  @@map("users")
}

// =============================================================================
// PROJECTS
// =============================================================================

model Project {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  user_id String

  user User @relation(fields: [user_id], references: [public_id])

  project_name String

  project_description String?

  image_url String?

  is_active Boolean @default(true)

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  environments Environment[]

  api_keys ApiKeys[]

  @@map("projects")
}

// =============================================================================
// ENVIRONMENTS
// =============================================================================

model Environment {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  project_id String

  project Project @relation(fields: [project_id], references: [public_id])

  environment_name String

  is_active Boolean @default(true)

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  environment_service_providers EnvironmentServiceProvider[]

  request_logs RequestLog[]

  api_keys ApiKeys[]

  @@map("environments")
}

// =============================================================================
// ENVIRONMENT SERVICE PROVIDERS
// =============================================================================

model EnvironmentServiceProvider {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  environment_id String

  environment Environment @relation(fields: [environment_id], references: [public_id])

  service_type_id String

  service_type ServiceType @relation(fields: [service_type_id], references: [public_id])

  provider_id String

  provider Provider @relation(fields: [provider_id], references: [public_id])

  credentials Json

  endpoint String

  is_active Boolean @default(true)

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  request_logs RequestLog[]

  @@unique([environment_id, service_type_id, provider_id])
  @@map("environment_service_providers")
}

// =============================================================================
// REQUEST LOGS
// =============================================================================

model RequestLog {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  environment_id String

  environment Environment @relation(fields: [environment_id], references: [public_id])

  environment_service_provider_id String

  environment_service_provider EnvironmentServiceProvider @relation(fields: [environment_service_provider_id], references: [public_id])

  service_type String

  provider_slug String

  status RequestStatus @default(PENDING)

  request_data Json?

  response_data Json?

  error String?

  retry_count Int @default(0)

  last_retried_at DateTime?

  created_at DateTime @default(now())

  @@map("request_logs")
}

// =============================================================================
// API KEYS
// =============================================================================

model ApiKeys {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  project_id String

  project Project @relation(fields: [project_id], references: [public_id])

  environment_id String

  environment Environment @relation(fields: [environment_id], references: [public_id])

  note String?

  api_key String @unique

  prefix String

  mode ApiKeyMode

  expires_in_days Int?

  expires_at DateTime?

  last_used_at DateTime?

  is_active Boolean @default(true)

  is_deleted Boolean @default(false)

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  @@map("api_keys")
}
