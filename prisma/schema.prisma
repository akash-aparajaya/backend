// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// =============================================================================
// Prisma Schema
// Database: PostgreSQL
// Project: Multi-service, Multi-provider, Multi-environment Management Platform
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  ADMIN
  SUPER_ADMIN
  USER
}

enum RequestStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ApiKeyMode {
  SANDBOX
  LIVE
}

// =============================================================================
// SERVICE TYPES
// =============================================================================

model ServiceType {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  slug String @unique

  name String @unique

  description String?

  service_base_endpoint String?

  is_active Boolean @default(true)

   is_failover           Boolean @default(true)

  providers Provider[]

  environment_service_providers EnvironmentServiceProvider[]

  @@map("service_types")
}

// =============================================================================
// PROVIDERS
// =============================================================================

model Provider {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  service_type_id String

  service_type ServiceType @relation(fields: [service_type_id], references: [public_id])

  name String

  slug String @unique

  base_endpoint String

  required_credential_schema Json

  is_active Boolean @default(true)

  environment_service_providers EnvironmentServiceProvider[]

  smsQueues SmsQueue[]

  emailQueues EmailQueue[]

  whatsAppQueues WhatsAppQueue[]

  @@map("providers")
}

// =============================================================================
// USERS
// =============================================================================

model User {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  email String 

  password String

  user_name String

  role UserRole @default(ADMIN)

  phone_number String?

  is_phone_verified Boolean @default(false)

  is_deleted Boolean @default(false)

  is_active Boolean @default(true)

  reset_token String?

  reset_token_expiry DateTime?

  refresh_token_hash String?

  refresh_token_expires_at DateTime?

  last_login_at DateTime?

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  deleted_at DateTime?

  projects             Project[]
  environmentEmployees EnvironmentEmployee[]

  @@map("users")
}

// =============================================================================
// PROJECTS
// =============================================================================

model Project {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  user_id String

  user User @relation(fields: [user_id], references: [public_id])

  project_name String

  project_description String?

  image_url String?

  is_active Boolean @default(true)

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  is_deleted Boolean @default(false)

  environments Environment[]

  api_keys             ApiKeys[]
  environmentEmployees EnvironmentEmployee[]
  smsQueues            SmsQueue[]
  emailQueues          EmailQueue[]
  whatsAppQueues       WhatsAppQueue[]

  @@map("projects")
}

// =============================================================================
// ENVIRONMENTS
// =============================================================================

model Environment {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  project_id String

  project Project @relation(fields: [project_id], references: [public_id])

  environment_name String

  is_active Boolean @default(true)

  is_deleted Boolean @default(false)

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  environment_service_providers EnvironmentServiceProvider[]

  api_keys             ApiKeys[]
  environmentEmployees EnvironmentEmployee[]
  smsQueues            SmsQueue[]
  emailQueues          EmailQueue[]
  whatsAppQueues       WhatsAppQueue[]

  @@map("environments")
}

// =============================================================================
// ENVIRONMENT SERVICE PROVIDERS
// =============================================================================

model EnvironmentServiceProvider {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  environment_id String

  environment Environment @relation(fields: [environment_id], references: [public_id])

  service_type_id String

  service_type ServiceType @relation(fields: [service_type_id], references: [public_id])

  provider_id String

  provider Provider @relation(fields: [provider_id], references: [public_id])

  provider_name String

  mode ApiKeyMode

  credentials Json

  provider_slug String?

  is_active Boolean @default(true)

  sort_order Int @default(1)

  last_failed_at DateTime?
  
  last_error_message String?

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  @@unique([environment_id, service_type_id, provider_id, mode, is_active])
  @@map("environment_service_providers")
}

// =============================================================================
// API KEYS
// =============================================================================

model ApiKeys {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  project_id String

  project Project @relation(fields: [project_id], references: [public_id])

  environment_id String

  environment Environment @relation(fields: [environment_id], references: [public_id])

  note String?

  api_key String @unique

  prefix String

  mode ApiKeyMode

  expires_in_days Int?

  expires_at DateTime?

  last_used_at DateTime?

  is_active Boolean @default(true)

  is_deleted Boolean @default(false)

  created_at DateTime @default(now())

  updated_at DateTime @updatedAt

  @@map("api_keys")
}

model EnvironmentEmployee {
  id Int @id @default(autoincrement())

  public_id String @unique @default(cuid())

  project_id String
  project    Project @relation(fields: [project_id], references: [public_id])

  environment_id String
  environment    Environment @relation(fields: [environment_id], references: [public_id])

  user_id String
  user    User   @relation(fields: [user_id], references: [public_id])

  status Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([environment_id, user_id, project_id])
  @@map("environment_employees")
}

enum QueueStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  RETRY
}

enum PrioritySegment {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum MessageType {
  OTP
  TRANSACTION
  MARKETING
}

model SmsQueue {
  id        Int    @id @default(autoincrement())
  public_id String @unique @default(cuid())

  // Context (minimal but enough)
  project_id     String?
  environment_id String?
  provider_id    String?
  mode           ApiKeyMode

  // Message details
  type          MessageType
  recipient     String
  message       String
  template_name String?

  // Queue control
  status         QueueStatus     @default(PENDING)
  priority       PrioritySegment @default(MEDIUM)
  priority_value Int             @default(2)

  // Idempotency (prevents duplicate requests)
  idempotency_key String? @unique

  // Retry system
  attempts     Int @default(0)
  max_attempts Int @default(3)

  // Scheduling
  scheduled_at DateTime?
  processed_at DateTime?
  sent_at      DateTime?

  // Locking (prevents duplicate processing)
  locked_at DateTime?
  locked_by String?

  // Logs
  request_payload  Json?
  response_payload Json?
  error_message    String?

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project     Project?     @relation(fields: [project_id], references: [public_id])
  environment Environment? @relation(fields: [environment_id], references: [public_id])
  provider    Provider?    @relation(fields: [provider_id], references: [public_id])

  // Indexes (VERY important for workers)
  @@index([status])
  @@index([scheduled_at])
  @@index([locked_at])
  @@index([project_id])
  @@index([provider_id])
  @@index([environment_id])
}

model EmailQueue {
  id        Int    @id @default(autoincrement())
  public_id String @unique @default(cuid())

  project_id     String?
  environment_id String?
  provider_id    String?
  mode           String?

  type          MessageType
  recipient     String
  subject       String?
  message       String
  template_name String?

  status   QueueStatus     @default(PENDING)
  priority PrioritySegment @default(MEDIUM)
  priority_value Int             @default(2)

  idempotency_key String? @unique

  attempts     Int @default(0)
  max_attempts Int @default(2)

  scheduled_at DateTime?
  processed_at DateTime?
  sent_at      DateTime?

  locked_at DateTime?
  locked_by String?

  request_payload  Json?
  response_payload Json?
  error_message    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // RELATIONS
  project     Project?     @relation(fields: [project_id], references: [public_id])
  environment Environment? @relation(fields: [environment_id], references: [public_id])
  provider    Provider?    @relation(fields: [provider_id], references: [public_id])

  @@index([status])
  @@index([scheduled_at])
  @@index([locked_at])
  @@index([project_id])
  @@index([provider_id])
  @@index([environment_id])
}

model WhatsAppQueue {
  id        Int    @id @default(autoincrement())
  public_id String @unique @default(cuid())

  project_id     String?
  environment_id String?
  provider_id    String?
  mode           String?

  type          MessageType
  recipient     String
  message       String
  template_name String?

  status   QueueStatus     @default(PENDING)
  priority PrioritySegment @default(MEDIUM)
  priority_value Int             @default(2)
  idempotency_key String? @unique

  attempts     Int @default(0)
  max_attempts Int @default(2)

  scheduled_at DateTime?
  processed_at DateTime?
  sent_at      DateTime?

  locked_at DateTime?
  locked_by String?

  request_payload  Json?
  response_payload Json?
  error_message    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // RELATIONS
  project     Project?     @relation(fields: [project_id], references: [public_id])
  environment Environment? @relation(fields: [environment_id], references: [public_id])
  provider    Provider?    @relation(fields: [provider_id], references: [public_id])

  @@index([status])
  @@index([scheduled_at])
  @@index([locked_at])
  @@index([project_id])
  @@index([provider_id])
  @@index([environment_id])
}

